{
  "name": "jdm-electron",
  "version": "1.0.3",
  "description": "JDM | Flask & Electron Template",
  "author": "JDM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.jdm.jdm-plugin-manager.app",
    "productName": "JDM Plugin Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "loading.html",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "resources/backend/flask_server",
        "to": "backend/flask_server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "JDM-Github",
      "repo": "jdm-plugin-manager"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  }
}